# ============================================================
# upbit-auto-trader 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 절대 커밋하지 않는다.
# ============================================================

# ----- Upbit API Key -----
# 업비트 > 마이페이지 > Open API 관리 에서 발급.
# 권한은 [자산조회]·[주문조회](필요 시 [주문하기])만 부여하고, 출금 권한은 절대 부여하지 않는다.
# 발급 시 이 프로그램을 실행할 PC의 공인 IP를 허용 목록에 등록해야 한다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ----- 거래 모드: BACKTEST | PAPER | LIVE (기본 PAPER) -----
TRADING_MODE=PAPER
# 실제 주문은 TRADING_MODE=LIVE 이면서 LIVE_TRADING_ENABLED=true 일 때만 허용된다 (정확히 true/false 만 인정, 1·yes·on 은 오류).
# 둘 중 하나라도 아니면 실제 주문 API는 호출되지 않는다.
LIVE_TRADING_ENABLED=false

# ----- 거래 대상 마켓 (쉼표 구분) -----
MARKETS=KRW-BTC,KRW-ETH

# ----- 전략 (Phase 3) -----
# 전략 이름 (README '전략 목록' 참고)
#   추세 추종: ma_cross (SMA 교차), ema_cross (EMA 정배열), macd (MACD 시그널 교차), ichimoku (구름 돌파)
#   평균 회귀: rsi, bollinger (밴드 재진입), stochastic, cci, williams_r
#   돌파: volume_breakout (가격 + 거래량)      필터: adx_trend (ADX 추세 강도), obv (OBV 거래량 추세)
STRATEGY_NAME=ma_cross
# 전략 파라미터. 비우면 전략 기본값. key=value 목록 또는 JSON 객체.
# 예: short_window=20,long_window=60 (ma_cross) / fast_period=12,slow_period=26,zero_line_filter=false (macd)
STRATEGY_PARAMS=
# 전략이 보는 캔들 단위: 1m,3m,5m,10m,15m,30m,60m,240m,1d 등
CANDLE_INTERVAL=60m

# ----- 모의매매 (Phase 5) -----
PAPER_INITIAL_CASH=1000000
PAPER_FEE_RATE=0.0005
PAPER_SLIPPAGE_RATE=0.0005
POSITION_FRACTION=1.0
WARMUP_CANDLES=300
SNAPSHOT_INTERVAL_SECONDS=300
# bot_logs·balances 보존 일수 (엔진 시작 시 그 이전 기록 삭제, 0 = 무제한)
DB_RETENTION_DAYS=90

# ----- 리스크 관리 (Phase 6) — 비우거나 off 로 두면 해당 규칙을 끈다 -----
RISK_MAX_ORDER_AMOUNT=
RISK_MAX_POSITION_RATIO=1.0
RISK_MAX_OPEN_POSITIONS=1
RISK_DAILY_LOSS_LIMIT_PCT=0.03
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_STOP_LOSS_PCT=0.05
RISK_TAKE_PROFIT_PCT=
RISK_TRAILING_STOP_PCT=
RISK_PRICE_DEVIATION_LIMIT=0.10
RISK_COOLDOWN_SECONDS=0
# 청산 조건이 연속 N번의 시세에서 관측돼야 매도 (단일 이상 틱 방어). 시세가 이보다 오래되면 주문 보류(초)
EXIT_CONFIRM_TICKS=2
# 직전 종가 대비 이 비율 넘게 튄 캔들은 이상치로 보고 신호 실행 보류 (0.3 = 30%)
CANDLE_ANOMALY_PCT=0.3
PRICE_MAX_AGE_SECONDS=30

# ----- 대시보드 (Phase 8) -----
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# 설정하면 변경·제어 API 에 X-Auth-Token 헤더가 필요하다. 비우면 로컬(127.0.0.1)에서만 변경 허용.
DASHBOARD_TOKEN=
# 포켓 자산 이전용 메인포켓 키 (권한: 포켓관리 만). 비우면 대시보드에서 메인→봇 포켓 이전 불가.
UPBIT_POCKET_ACCESS_KEY=
UPBIT_POCKET_SECRET_KEY=

# ----- 데이터베이스 (초기에는 SQLite) -----
DATABASE_URL=sqlite:///./data/trader.db

# ----- 로그 -----
LOG_LEVEL=INFO
LOG_DIR=logs

# ----- HTTP 클라이언트 -----
UPBIT_API_URL=https://api.upbit.com
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3

# ----- 알림 (Phase 9) — 매수/매도/체결/손절/일일 손실 한도/API 오류/봇 시작·중지 -----
# Telegram: @BotFather 로 봇 생성 → 토큰. 채널이면 봇을 채널 관리자로 추가하고 메시지를 하나 올린 뒤
#   `python -m app.main notify-test --discover-telegram` 으로 채널 ID(-100…) 확인 → TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: 채널 설정 > 연동 > 웹훅 > URL 복사
DISCORD_WEBHOOK_URL=
# 보낼 이벤트: all / off / 쉼표 목록 — buy, sell, order_filled, order_rejected, stop_loss, take_profit, trailing_stop,
#   daily_loss_limit, consecutive_loss_limit, risk_halt, api_error, bot_start, bot_stop, settings, account
NOTIFY_EVENTS=all
# 같은 API 오류의 반복 알림 억제(초)
NOTIFY_ERROR_COOLDOWN_SECONDS=300
# 알림 본문을 로그(logs/)에도 남김 — 채널이 없어도 알림 파이프라인 동작 확인 가능
NOTIFY_LOG=true
