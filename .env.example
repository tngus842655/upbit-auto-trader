# ============================================================
# upbit-auto-trader 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 절대 커밋하지 않는다.
# ============================================================

# ----- Upbit API Key -----
# 업비트 > 마이페이지 > Open API 관리 에서 발급.
# 권한은 [자산조회]·[주문조회](필요 시 [주문하기])만 부여하고, 출금 권한은 절대 부여하지 않는다.
# 발급 시 이 프로그램을 실행할 PC의 공인 IP를 허용 목록에 등록해야 한다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ----- 거래 모드: BACKTEST | PAPER | LIVE (기본 PAPER) -----
TRADING_MODE=PAPER
# 실제 주문은 TRADING_MODE=LIVE 이면서 LIVE_TRADING_ENABLED=true 일 때만 허용된다.
# 둘 중 하나라도 아니면 실제 주문 API는 호출되지 않는다.
LIVE_TRADING_ENABLED=false

# ----- 거래 대상 마켓 (쉼표 구분) -----
MARKETS=KRW-BTC,KRW-ETH

# ----- 전략 (Phase 3) -----
# 전략 이름: ma_cross (이동평균 교차), rsi (RSI 평균회귀)
STRATEGY_NAME=ma_cross
# 전략 파라미터. 비우면 전략 기본값. key=value 목록 또는 JSON 객체. 예: short_window=20,long_window=60
STRATEGY_PARAMS=
# 전략이 보는 캔들 단위: 1m,3m,5m,10m,15m,30m,60m,240m,1d 등
CANDLE_INTERVAL=60m

# ----- 모의매매 (Phase 5) -----
PAPER_INITIAL_CASH=1000000
PAPER_FEE_RATE=0.0005
PAPER_SLIPPAGE_RATE=0.0005
POSITION_FRACTION=1.0
WARMUP_CANDLES=300
SNAPSHOT_INTERVAL_SECONDS=300

# ----- 리스크 관리 (Phase 6) — 비우거나 off 로 두면 해당 규칙을 끈다 -----
RISK_MAX_ORDER_AMOUNT=
RISK_MAX_POSITION_RATIO=1.0
RISK_MAX_OPEN_POSITIONS=1
RISK_DAILY_LOSS_LIMIT_PCT=0.03
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_STOP_LOSS_PCT=0.05
RISK_TAKE_PROFIT_PCT=
RISK_TRAILING_STOP_PCT=
RISK_PRICE_DEVIATION_LIMIT=0.10
RISK_COOLDOWN_SECONDS=0

# ----- 데이터베이스 (초기에는 SQLite) -----
DATABASE_URL=sqlite:///./data/trader.db

# ----- 로그 -----
LOG_LEVEL=INFO
LOG_DIR=logs

# ----- HTTP 클라이언트 -----
UPBIT_API_URL=https://api.upbit.com
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
